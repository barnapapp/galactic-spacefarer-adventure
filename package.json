{
  "name": "galactir-spacefarer-adventure",
  "version": "1.0.0",
  "description": "Galactic Spacefarer Adventure System",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sap/cds": "^9.9.1",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sapui5/types": "^1.148.1",
    "@types/node": "^20.19.41",
    "@ui5/cli": "^4.0.55",
    "@ui5/ts-interface-generator": "^0.11.1",
    "cds-plugin-ui5": "^0.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "ui5-tooling-transpile": "^3.11.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "galactic.db"
        }
      }
    },
    "typescript": true
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/spacefarer-adventure"
  ]
}
